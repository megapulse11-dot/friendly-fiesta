# Normalise line endings so the working tree stays clean.
# admin/server.ps1 rewrites data.js with LF on every start, so without this Git
# would report the file as modified every time the server ran.
* text=auto

*.js   text eol=lf
*.json text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.md   text eol=lf

# Generated files. These are rewritten on every save (data.js) or every run of
# a script in scripts/ (sitemap.xml, property/*.html), so if Git were allowed to
# convert them to CRLF in the working tree it would report them as modified on
# the very next regeneration - a diff that is nothing but line endings, and
# enough to make somebody distrust the generator.
sitemap.xml text eol=lf
robots.txt  text eol=lf
property/   text eol=lf

# Windows-native scripts.
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# Images are binary - never let Git try to normalise them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.woff2 binary
