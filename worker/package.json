{
  "name": "northwind-enquiries-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: enquiries inbox, plus agent accounts and listing submissions.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/auth.test.js test/integration.test.js",
    "db:create": "wrangler d1 create northwind",
    "db:migrate": "wrangler d1 migrations apply northwind",
    "bucket:create": "wrangler r2 bucket create northwind-photos"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
